# ==============================================================================
# PRIVORA — THE AI FIREWALL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=3001

# 1. Supabase Database Configuration (Optional for persistence, in-memory fallback enabled)
# Get these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. External AI LLM Providers (Optional for live LLM inference, defensive simulator active by default)
# Keys are stored ONLY on backend and never exposed to the client browser.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
