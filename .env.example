# ==============================================================================
# TRUSTWALL AI FIREWALL — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (Node.js / Express / Serverless)
# Loaded by server/server.ts via dotenv
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Supabase Database Configuration (Optional for persistence; in-memory fallback active)
# Get these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# External AI LLM API Keys (Optional for live LLM proxy inference)
# Keys are stored ONLY on backend and never exposed to the client browser
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=


# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Vite / React 19)
# Note: In Vite, variables prefixed with VITE_ are exposed to the browser client
# ------------------------------------------------------------------------------
VITE_APP_NAME="TrustWall AI Firewall"
VITE_APP_VERSION="3.0.0"

# Gateway API base route (/api for same-origin proxy, or http://localhost:3001/api for standalone)
VITE_API_URL=/api

# Client-Side Supabase Access (Safe public anon key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Feature Flags
VITE_ENABLE_LOCAL_HEURISTICS=true
VITE_ENABLE_WEB_CRYPTO=true
